[Unit]
Description=TotalDrop relay server (ARM64)
Documentation=https://totaldrop.app
After=network-online.target
Wants=network-online.target

[Service]
# WebSocket behind Caddy on loopback; address discovery on UDP 443.
ExecStart=/usr/local/bin/totaldrop-relay 127.0.0.1:4100 [::]:443
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=aarch64
# Nothing about clients is logged; stderr only reports the listen addresses.
LimitNOFILE=65536
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
